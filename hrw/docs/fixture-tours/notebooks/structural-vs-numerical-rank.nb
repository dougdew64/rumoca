Cell[5061, 138, 100, 0, 70, "Section",ExpressionUUID->"d07a71df-5940-d54a-8321-c858f54c2fe0"],
Cell[5164, 140, 118, 0, 70, "Text",ExpressionUUID->"62966823-51ea-3940-b350-e8cbda900415"],
Cell[5285, 142, 288, 4, 70, "Item",ExpressionUUID->"24a4fed0-4b84-5040-a259-eea15f17bf57"],
